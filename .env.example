# VoiceShield AI - Environment Variables
# Copy this to .env for local development, set these on your cloud platform for production

# Demo mode (true = marks results as demo/decision-support)
VOICESHIELD_DEMO_MODE=true

# CORS: comma-separated list of allowed origins (use * for dev only)
# Example for production: https://voiceshield-ai.vercel.app
ALLOWED_ORIGINS=*

# Path to demo sample WAV files (relative to project root)
SAMPLES_DIR=frontend/assets/samples

# Server host and port (overridden by cloud platform PORT env var)
HOST=0.0.0.0
PORT=8000
